{
  "datasets": [
    {
      "name": "kommuner_detalj",
      "displayName": "Alle kommuner",
      "config": {
        "version": 1.1,
        "source": "SELECT\n  kommune_label AS kommune,\n  total_befolkning AS innbyggere,\n  pension_age_befolkning AS innbyggere_55_pluss,\n  ROUND(pension_age_share * 100, 1) AS andel_pst\nFROM pensjon_lakehouse.gold.kommuner_pensjonsalder\nORDER BY andel_pst DESC\n",
        "dimensions": [
          {
            "name": "kommune",
            "expr": "kommune",
            "displayName": "Kommune"
          }
        ],
        "measures": [
          {
            "name": "innbyggere",
            "expr": "SUM(innbyggere)",
            "displayName": "Innbyggere",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "innbyggere_55_pluss",
            "expr": "SUM(innbyggere_55_pluss)",
            "displayName": "Innbyggere 55+",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "andel_pst",
            "expr": "MAX(andel_pst)",
            "displayName": "Andel 55+",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "aldersgruppe_trend",
      "displayName": "Aldersgruppe trend",
      "config": {
        "version": 1.1,
        "source": "pensjon_lakehouse.gold.aldersgruppe_trend",
        "dimensions": [
          {
            "name": "year",
            "expr": "CAST(year AS INT)",
            "displayName": "År"
          },
          {
            "name": "aldersgruppe",
            "expr": "aldersgruppe",
            "displayName": "Aldersgruppe"
          },
          {
            "name": "aldersgruppe_sortering",
            "expr": "aldersgruppe_sortering",
            "displayName": "Sortering"
          }
        ],
        "measures": [
          {
            "name": "andel",
            "expr": "MAX(andel)",
            "displayName": "Andel",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "befolkning",
            "expr": "SUM(befolkning)",
            "displayName": "Befolkning",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "top_kommuner",
      "displayName": "Top 10 kommuner",
      "config": {
        "version": 1.1,
        "source": "SELECT\n  kommune_label AS kommune,\n  total_befolkning AS innbyggere,\n  pension_age_befolkning AS innbyggere_55_pluss,\n  ROUND(pension_age_share * 100, 1) AS andel_pst\nFROM pensjon_lakehouse.gold.top_kommuner_pensjonsalder\nORDER BY andel_pst DESC\nLIMIT 10\n",
        "dimensions": [
          {
            "name": "kommune",
            "expr": "kommune",
            "displayName": "Kommune"
          }
        ],
        "measures": [
          {
            "name": "innbyggere",
