            "displayName": "Andel 55+",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "top_naeringer",
      "displayName": "Top 10 næringer",
      "config": {
        "version": 1.1,
        "source": "SELECT\n  naering_label AS naering,\n  lonsstakere,\n  manedslonn,\n  ROUND(estimert_pensjonsvolum / 1e9, 2) AS volum_mrd\nFROM pensjon_lakehouse.gold.naering_pensjonsvolum WHERE naering_label != 'Alle næringer' ORDER BY volum_mrd DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "naering",
            "expr": "naering",
            "displayName": "Næring"
          }
        ],
        "measures": [
          {
            "name": "lonsstakere",
